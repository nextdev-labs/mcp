{
  "name": "@nextdev-labs/mcp",
  "version": "0.6.1",
  "description": "Local-first MCP to query your own AI work history — reads the session transcripts your coding agent already writes (~/.claude/projects), cuts the noise, and returns clean, token-efficient slices of what you worked on. Plus a developer-API index (docs / rankings / reviews) proxied from Nextdev. Zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "dist/worklog/queryEngine.js",
  "bin": {
    "nextdev-worklog": "dist/worklog/stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/worklog/stdio.js",
    "dev": "tsx src/worklog/stdio.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(add eslint when ready)\""
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nextdev-labs/mcp.git"
  },
  "homepage": "https://www.joinnextdev.com/labs",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent",
    "worklog",
    "work-history",
    "claude-code",
    "developer-apis",
    "nextdev"
  ]
}
